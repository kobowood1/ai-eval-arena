# Database (Neon)
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# NextAuth v5
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=xxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxx

# Resend (magic-link email) — https://resend.com/
AUTH_RESEND_KEY=re_xxxx
AUTH_RESEND_FROM=noreply@arena.ai

# WebSocket runtime URL (used by the Next.js app to connect clients)
NEXT_PUBLIC_RUNTIME_URL=ws://localhost:3001
